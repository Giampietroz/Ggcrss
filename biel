
* {

box-sizing: border-box;

}


body {

margin: 0;

font-family: Arial, Helvetica, sans-serif;

}



.barra-topo {

position: fixed;

top: 0;

left: 0;

width: 100%;

padding: 15px 20px;

background-color: #2c3e50;

z-index: 1000;

}




.barra-topo ul {

list-style: none;

margin: 0;

padding: 0;

}


.barra-topo li {

float: left;

}


.barra-topo a {

display: block;

padding: 0 15px;

line-height: 20px;

color: #ffffff;

text-decoration: none;

}




.barra-topo::after {

content: "";

display: block;

clear: both;

}




.aviso {

position: relative;

padding: 12px 45px 12px 20px;

margin: 65px 20px 0 20px;

background-color: #f1c40f;

border-radius: 4px;

}




#fechar-aviso {

position: absolute;

top: 8px;

right: 14px;

font-size: 22px;

cursor: pointer;

}




.mensagem {

margin: 0;

color: #2c3e50;

font-weight: bold;

}



main {

margin-top: 20px;

padding: 0 20px;

}

main p {

line-height: 1.6;

margin-bottom: 16px;

}
